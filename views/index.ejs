      <p class="text-xs text-gray-400"><%= t.EV_Facts.EV_fact2 %></p>
    </div>
    <div class="bg-white border border-gray-100 rounded-sm p-6">
      <p class="text-4xl font-semibold text-emerald-500 mb-2">40%</p>
      <p class="text-sm font-black text-gray-900 mb-1"><%= t.EV_Facts.EV_fact3 %></p>
      <p class="text-xs text-gray-400"><%= t.EV_Facts.EV_fact4 %></p>
    </div>
    <div class="bg-white border border-gray-100 rounded-sm p-6">
      <p class="text-4xl font-semibold text-emerald-500 mb-2">800+</p>
      <p class="text-sm font-black text-gray-900 mb-1"><%= t.EV_Facts.EV_fact5 %></p>
      <p class="text-xs text-gray-400"><%= t.EV_Facts.EV_fact6 %></p>
    </div>
    <div class="bg-white border border-gray-100 rounded-sm p-6">
      <p class="text-4xl font-semibold text-emerald-500 mb-2">20min</p>
      <p class="text-sm font-black text-gray-900 mb-1"><%= t.EV_Facts.EV_fact7 %></p>
      <p class="text-xs text-gray-400"><%= t.EV_Facts.EV_fact8 %></p>
    </div>
  </div>
</div>

<!-- Data section -->
<div class="mt-24 mb-10 grid grid-cols-1 px-10 lg:grid-cols-2 gap-12 items-start">
  
  <!-- Left — text -->
