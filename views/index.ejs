    <p class="text-xs text-gray-400 uppercase tracking-widest mb-2"><%= t.database.database_span %></p>
    <h2 class="text-2xl font-black text-gray-900 mb-4"><%= t.database.database_title %></h2>
    <p class="text-sm text-gray-500 leading-relaxed mb-6"><%= t.database.database_subtitle %></p>
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-gray-50 rounded-sm p-4">
        <p class="text-2xl font-black text-gray-900"><%= stats.total %></p>
        <p class="text-xs text-gray-400 mt-1"><%= t.database.database_stat1 %></p>
      </div>
      <div class="bg-gray-50 rounded-sm p-4">
        <p class="text-2xl font-black text-gray-900"><%= stats.brands %></p>
        <p class="text-xs text-gray-400 mt-1"><%= t.database.database_stat2 %></p>
      </div>
      <div class="bg-gray-50 rounded-sm p-4">
        <p class="text-2xl font-black text-gray-900"><%= stats.with_images %></p>
        <p class="text-xs text-gray-400 mt-1"><%= t.database.database_stat4 %></p>
      </div>
      <div class="bg-gray-50 rounded-sm p-4">
        <p class="text-2xl font-black text-gray-900"><%= new Date().getFullYear() - stats.oldest_year %>+</p>
        <p class="text-xs text-gray-400 mt-1"><%= t.database.database_stat3 %></p>
      </div>
    </div>
  </div>

  <!-- Right — table -->
  <div>
    <p class="text-xs text-gray-400 uppercase tracking-widest mb-4"><%= t.database.database_stat5 %></p>
    <div class="border border-gray-100 rounded-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100">
            <th class="text-left text-xs text-gray-400 font-black px-4 py-3"><%= t.database.database_li1 %></th>
            <th class="text-right text-xs text-gray-400 font-black px-4 py-3"><%= t.database.database_li2 %></th>
            <th class="text-right text-xs text-gray-400 font-black px-4 py-3"><%= t.database.database_li3 %></th>
            <th class="text-right text-xs text-gray-400 font-black px-4 py-3"><%= t.database.database_li4 %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% fuelstats.forEach(row => { %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-gray-700 capitalize"><%= row.fuel_type %></td>
            <td class="px-4 py-3 text-right font-black text-gray-500"><%= Number(row.count).toLocaleString() %></td>
            <td class="px-4 py-3 text-right font-black text-gray-500">$<%= Number(row.avg_price).toLocaleString() %></td>
            <td class="px-4 py-3 text-right font-black text-gray-500"><%= row.avg_hp ? row.avg_hp + ' hp' : '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
 <%- include('partials/footer') %>

<script>
  lucide.createIcons();
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const input      = document.getElementById('searchInput');
    const typeFilter = document.getElementById('typeFilter');
    const searchBtn  = document.getElementById('searchBtn');
    const grid       = document.getElementById('carGrid');
    const noResults  = document.getElementById('noResults');

    if (!input || !searchBtn || !grid) return;

    async function doSearch() {
      const q = input.value.trim() || typeFilter.value.trim();
      if (!q) {
        location.reload();
        return;
      }
      const res  = await fetch(`/search?q=${encodeURIComponent(q)}`);
      const cars = await res.json();
      if (cars.length === 0) {
        grid.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }
      noResults.classList.add('hidden');
      grid.innerHTML = cars.map(v => `
        <div class="bg-white rounded-sm p-6 border border-gray-100">
          <img src="${v.image_url}" alt="${v.make} ${v.model}" class="w-full h-40 object-cover rounded mb-4">
          <h3 class="font-semibold text-gray-900 text-lg">${v.make} ${v.model}</h3>
          <p class="text-sm text-gray-500 mt-1">${v.year} · ${v.vehicle_style} · ${v.driven_wheels}</p>
          <p class="text-emerald-600 font-semibold mt-2">$${v.msrp ? v.msrp.toLocaleString() : 'N/A'}</p>
          <div class="flex gap-3 mt-2">
            <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full">${v.fuel_type}</span>
            <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full">${v.horsepower ? v.horsepower + ' hp' : 'N/A'}</span>
          </div>
          <a href="/cars/${v.make}-${v.model}" class="inline-block mt-4 text-sm font-medium text-emerald-600 hover:text-emerald-700">
            View Details →
          </a>
        </div>
      `).join('');
    }

    searchBtn.addEventListener('click', doSearch);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') doSearch(); });
    typeFilter.addEventListener('change', doSearch);
    resetBtn.addEventListener('click', () => {
      input.value = '';
      typeFilter.value = '';
      location.reload();
    });
  });
</script>

<script>
function applyMobileLimit() {
  const cards = document.querySelectorAll('#carGrid > div');
  const isMobile = window.innerWidth < 768;
  cards.forEach((card, index) => {
    if (isMobile && index >= 8) {
      card.classList.add('hidden');
    } else {
      card.classList.remove('hidden');
    }
  });
}

applyMobileLimit();
window.addEventListener('resize', applyMobileLimit);
</script>
