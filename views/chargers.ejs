<%- include('partials/header', { navLinks, currentPath }) %>
<!-- Load Leaflet after header -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    #map { height: 560px; width: 100%; border-radius: 4px; }
    .charger-card.active { border-color: #10b981; }
  </style>
  <style>
  .leaflet-pane,
  .leaflet-tile-container,
  .leaflet-overlay-pane,
  .leaflet-shadow-pane,
  .leaflet-marker-pane,
  .leaflet-popup-pane {
    z-index: 1 !important;
  }
</style>
</head>
<body class="bg-[#f9f8f6]">
<section class="pt-16 pb-4 px-6 lg:px-16 max-w-7xl mx-auto">

  <div class="mb-8">
    <h1 class="text-3xl font-semibold text-gray-900 mb-2"> <%= t.chargers_page.chargersTitle %></h1>
    <p class="text-sm text-gray-400"><%= t.chargers_page.chargersSubtitle %></p>
  </div>

  
  <!-- Search bar -->
  <div class="flex flex-col sm:flex-row gap-3 mb-8">
    <input 
      id="locationInput"
      type="text" 
      value="<%= location %>"
      placeholder="Enter city or address..."
      class="flex-1 px-4 py-3 rounded-sm border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
    >
    <button id="searchBtn" class="bg-emerald-500 hover:bg-emerald-600 text-white px-6 py-3 rounded-sm text-sm">
      <%= t.chargers_page.chargers_button1 %>
    </button>
    <button id="locateBtn" class="border border-gray-200 hover:border-emerald-500 hover:text-emerald-600 text-gray-500 px-4 py-3 rounded-sm text-sm">
    📍  <%= t.chargers_page.chargers_button2 %> 
    </button>
  </div>


  <!-- Filters -->
  <div class="flex flex-wrap gap-3 mb-8">
    <select id="connectorFilter" class="px-4 py-2 rounded-sm border border-gray-200 text-sm focus:outline-none">
      <option value="">All connectors</option>
      <option value="2">CHAdeMO</option>
      <option value="25">CCS</option>
      <option value="1">Type 1</option>
      <option value="3">Type 2</option>
      <option value="8">Tesla</option>
    </select>
    <select id="speedFilter" class="px-4 py-2 rounded-sm border border-gray-200 text-sm focus:outline-none">
      <option value="">All speeds</option>
      <option value="fast">Fast (50kW+)</option>
      <option value="medium">Medium (7-50kW)</option>
      <option value="slow">Slow (up to 7kW)</option>
    </select>
    <span id="resultCount" class="px-4 py-2 text-sm text-gray-400"></span>
  </div>


  <!-- Map + List -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">


    <!-- Map -->
    <div class="lg:col-span-2">
      <div id="map"></div>
    </div>


    <!-- Charger list -->
    <div class="overflow-y-auto max-h-[560px] flex flex-col gap-3 pr-1">
      <div id="chargerList">
        <p class="text-sm text-gray-400">Searching for chargers...</p>
      </div>
    </div>

  </div>


  <!-- Charger detail panel -->
  <div id="chargerDetail" class="hidden mt-8 bg-white border border-gray-100 rounded-sm p-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h2 id="detailName" class="text-lg font-semibold text-gray-900 mb-1"></h2>
        <p id="detailAddress" class="text-sm text-gray-400"></p>
      </div>
      <button onclick="document.getElementById('chargerDetail').classList.add('hidden')" class="text-gray-300 hover:text-gray-500 text-xl">✕</button>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
      <div class="bg-gray-50 rounded-sm p-3">
        <p class="text-xs text-gray-400 mb-1">Operator</p>
        <p id="detailOperator" class="text-sm font-medium text-gray-900"></p>
      </div>
      <div class="bg-gray-50 rounded-sm p-3">
        <p class="text-xs text-gray-400 mb-1">Connectors</p>
        <p id="detailConnectors" class="text-sm font-medium text-gray-900"></p>
      </div>
      <div class="bg-gray-50 rounded-sm p-3">
        <p class="text-xs text-gray-400 mb-1">Max power</p>
        <p id="detailPower" class="text-sm font-medium text-gray-900"></p>
      </div>
      <div class="bg-gray-50 rounded-sm p-3">
        <p class="text-xs text-gray-400 mb-1">Status</p>
        <p id="detailStatus" class="text-sm font-medium text-gray-900"></p>
      </div>
    </div>
    <div id="detailConnectorList" class="flex flex-wrap gap-2"></div>
  </div>


  <!-- Charger types explainer -->
  <div class="mt-16 mb-10">
    <h2 class="text-2xl font-semibold text-gray-900 mb-1"> <%= t.chargers_page.charger_connector1 %></h2>
    <p class="text-sm text-gray-400 mb-8"><%= t.chargers_page.charger_connector2 %></p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white border border-gray-100 rounded-sm p-5">
        <p class="text-2xl mb-3">⚡</p>
        <h3 class="font-semibold text-gray-900 mb-1"><%= t.chargers_page.chargers_type1 %></h3>
        <p class="text-xs text-gray-500"><%= t.chargers_page.charger_type1_Description1 %></p>
      </div>
      <div class="bg-white border border-gray-100 rounded-sm p-5">
        <p class="text-2xl mb-3">🔋</p>
        <h3 class="font-semibold text-gray-900 mb-1"><%= t.chargers_page.chargers_type2 %></h3>
        <p class="text-xs text-gray-500"> <%= t.chargers_page.charger_type2_Description2 %> </p>
      </div>
      <div class="bg-white border border-gray-100 rounded-sm p-5">
        <p class="text-2xl mb-3">🔌</p>
        <h3 class="font-semibold text-gray-900 mb-1"><%= t.chargers_page.chargers_type3 %></h3>
        <p class="text-xs text-gray-500"><%= t.chargers_page.charger_type2_Description3 %></p>
      </div>
      <div class="bg-white border border-gray-100 rounded-sm p-5">
        <p class="text-2xl mb-3">🅣</p>
        <h3 class="font-semibold text-gray-900 mb-1"><%= t.chargers_page.chargers_type4 %></h3>
        <p class="text-xs text-gray-500"><%= t.chargers_page.charger_type2_Description4 %></p>
      </div>
    </div>
  </div>


  <!-- Speed comparison -->
  <div class="mt-24 md:mb-12 mb-4">
    <h2 class="text-2xl font-semibold text-gray-900 mb-1"><%= t.chargers_page.charging_connector_title %></h2>
    <p class="text-sm text-gray-400 mb-8"><%= t.chargers_page.charging_connector_subtitle %></p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white border border-gray-100 rounded-sm p-6">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-3 h-3 rounded-full bg-gray-300"></span>
          <h3 class="font-semibold text-gray-900"><%= t.chargers_page.charging_speed1 %></h3>
        </div>
        <p class="text-3xl font-semibold text-gray-900 mb-1">2.3 kW</p>
        <p class="text-xs text-gray-400 mb-4"><%= t.chargers_page.charging_connector_type1 %></p>
        <div class="w-full bg-gray-100 rounded-full h-1.5 mb-3">
          <div class="bg-gray-300 h-1.5 rounded-full" style="width: 15%"></div>
        </div>
        <p class="text-xs text-gray-500"><%= t.chargers_page.charging_connector_description1 %></p>
      </div>
      <div class="bg-white border border-gray-100 rounded-sm p-6">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
          <h3 class="font-semibold text-gray-900"><%= t.chargers_page.charging_speed2 %></h3>
        </div>
        <p class="text-3xl font-semibold text-gray-900 mb-1">7–22 kW</p>
        <p class="text-xs text-gray-400 mb-4"><%= t.chargers_page.charging_connector_type2 %></p>
        <div class="w-full bg-gray-100 rounded-full h-1.5 mb-3">
          <div class="bg-emerald-400 h-1.5 rounded-full" style="width: 50%"></div>
        </div>
        <p class="text-xs text-gray-500"><%= t.chargers_page.charging_connector_description2 %></p>
      </div>
      <div class="bg-white border border-gray-100 rounded-sm p-6">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-3 h-3 rounded-full bg-blue-500"></span>
          <h3 class="font-semibold text-gray-900"><%= t.chargers_page.charging_speed3 %></h3>
        </div>
        <p class="text-3xl font-semibold text-gray-900 mb-1">50–350 kW</p>
        <p class="text-xs text-gray-400 mb-4"><%= t.chargers_page.charging_connector_type3 %></p>
        <div class="w-full bg-gray-100 rounded-full h-1.5 mb-3">
          <div class="bg-blue-500 h-1.5 rounded-full" style="width: 100%"></div>
        </div>
        <p class="text-xs text-gray-500"><%= t.chargers_page.charging_connector_description3 %></p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer', { lang }) %>

<script>
   document.addEventListener('DOMContentLoaded', () => {
const leafletMap = window.L.map('map').setView([52.52, 13.405], 12);

  window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
  }).addTo(leafletMap);

  let markers = [];
  let allChargers = [];

  const greenIcon = window.L.divIcon({
    className: '',
    html: '<div style="background:#10b981;width:12px;height:12px;border-radius:50%;border:2px solid white;box-shadow:0 0 4px rgba(0,0,0,0.3)"></div>',
    iconSize: [12, 12]
  });

  async function fetchChargers(lat, lng) {
    const res = await fetch(`/api/chargers?lat=${lat}&lng=${lng}`);
    allChargers = await res.json();
    renderChargers(allChargers);
  }

  function renderChargers(chargers) {
    markers.forEach(m => leafletMap.removeLayer(m));
    markers = [];

    document.getElementById('resultCount').textContent = `${chargers.length} chargers found`;
    document.getElementById('chargerList').innerHTML = '';

    if (chargers.length === 0) {
      document.getElementById('chargerList').innerHTML = '<p class="text-sm text-gray-400">No chargers found in this area.</p>';
      return;
    }

    chargers.forEach((charger) => {
      const lat = charger.AddressInfo?.Latitude;
      const lng = charger.AddressInfo?.Longitude;
      const name = charger.AddressInfo?.Title || 'Charging Station';
      const address = charger.AddressInfo?.AddressLine1 || '';
      const operator = charger.OperatorInfo?.Title || 'Unknown';
      const connections = charger.Connections || [];
      const maxPower = Math.max(...connections.map(c => c.PowerKW || 0));

      if (!lat || !lng) return;

      const marker = window.L.marker([lat, lng], { icon: greenIcon })
        .addTo(leafletMap)
        .on('click', () => showDetail(charger));
      markers.push(marker);

      const card = document.createElement('div');
      card.className = 'charger-card bg-white border border-gray-100 rounded-sm p-4 cursor-pointer hover:border-emerald-300 transition';
      card.innerHTML = `
        <div class="flex items-start justify-between mb-1">
          <p class="text-sm font-medium text-gray-900">${name}</p>
          <span class="text-xs ${maxPower >= 50 ? 'text-blue-500' : maxPower >= 7 ? 'text-emerald-500' : 'text-gray-400'} font-medium ml-2 whitespace-nowrap">${maxPower > 0 ? maxPower + ' kW' : 'N/A'}</span>
        </div>
        <p class="text-xs text-gray-400 mb-2">${address}</p>
        <p class="text-xs text-gray-300">${operator}</p>
      `;
      card.addEventListener('click', () => {
        leafletMap.setView([lat, lng], 15);
        showDetail(charger);
        document.querySelectorAll('.charger-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
      });
      document.getElementById('chargerList').appendChild(card);
    });
  }

  function showDetail(charger) {
    const panel = document.getElementById('chargerDetail');
    const connections = charger.Connections || [];
    const maxPower = Math.max(...connections.map(c => c.PowerKW || 0));

    document.getElementById('detailName').textContent = charger.AddressInfo?.Title || 'Charging Station';
    document.getElementById('detailAddress').textContent = [
      charger.AddressInfo?.AddressLine1,
      charger.AddressInfo?.Town,
      charger.AddressInfo?.Country?.Title
    ].filter(Boolean).join(', ');
    document.getElementById('detailOperator').textContent = charger.OperatorInfo?.Title || 'Unknown';
    document.getElementById('detailConnectors').textContent = connections.length;
    document.getElementById('detailPower').textContent = maxPower > 0 ? maxPower + ' kW' : 'N/A';
    document.getElementById('detailStatus').textContent = charger.StatusType?.Title || 'Unknown';

    document.getElementById('detailConnectorList').innerHTML = connections.map(c => `
      <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full">${c.ConnectionType?.Title || 'Unknown'} ${c.PowerKW ? '· ' + c.PowerKW + ' kW' : ''}</span>
    `).join('');

    panel.classList.remove('hidden');
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  async function geocodeAndSearch(locationStr) {
    const res = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(locationStr)}&format=json&limit=1`);
    const data = await res.json();
    if (data.length === 0) { alert('Location not found'); return; }
    const { lat, lon } = data[0];
    leafletMap.setView([lat, lon], 13);
    fetchChargers(lat, lon);
  }

  document.getElementById('searchBtn').addEventListener('click', () => {
    const loc = document.getElementById('locationInput').value.trim();
    if (loc) geocodeAndSearch(loc);
  });

  document.getElementById('locationInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') geocodeAndSearch(document.getElementById('locationInput').value.trim());
  });

  document.getElementById('locateBtn').addEventListener('click', () => {
    navigator.geolocation.getCurrentPosition(pos => {
      const { latitude, longitude } = pos.coords;
      leafletMap.setView([latitude, longitude], 13);
      fetchChargers(latitude, longitude);
    });
  });

  document.getElementById('speedFilter').addEventListener('change', () => {
    const speed = document.getElementById('speedFilter').value;
    let filtered = allChargers;
    if (speed === 'fast') filtered = allChargers.filter(c => Math.max(...(c.Connections || []).map(x => x.PowerKW || 0)) >= 50);
    if (speed === 'medium') filtered = allChargers.filter(c => { const max = Math.max(...(c.Connections || []).map(x => x.PowerKW || 0)); return max >= 7 && max < 50; });
    if (speed === 'slow') filtered = allChargers.filter(c => Math.max(...(c.Connections || []).map(x => x.PowerKW || 0)) < 7);
    renderChargers(filtered);
  });

  const initialLocation = '<%= location %>';
  geocodeAndSearch(initialLocation);
});
</script>